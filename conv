`timescale 1ns / 1ps

module conv_accelerator (
    input wire clk,             
    input wire rst_n,           
    
    input wire start,           
    output reg done,            
    output reg busy,      
      
    output reg [10:0] ram_addr, 
    input wire signed [7:0] ram_rdata, 
    
    output reg [12:0] out_ram_addr, 
    output reg out_ram_wen,         
    output reg signed [7:0] out_ram_wdata 
);

    localparam INPUT_H  = 49;
    localparam INPUT_W  = 40;
    localparam FILTER_H = 10;
    localparam FILTER_W = 8;
    localparam STRIDE   = 2;
    localparam PAD_TOP  = 4;  
    localparam PAD_LEFT = 3;

    reg signed [7:0]  weights    [0:639];
    reg signed [31:0] biases     [0:7];
    reg signed [7:0]  fc_weights [0:15999];
    reg signed [31:0] fc_biases  [0:3];
    
    reg signed [7:0]  conv_out_buf [0:3999];
    reg signed [31:0] fc_scores    [0:3];

    integer i;
    initial begin
        for(i=0; i<640;   i=i+1) weights[i]    = 0;
        for(i=0; i<8;     i=i+1) biases[i]     = 0;
        for(i=0; i<16000; i=i+1) fc_weights[i] = 0;
        for(i=0; i<4;     i=i+1) fc_biases[i]  = 0;
        for(i=0; i<4000;  i=i+1) conv_out_buf[i]= 0;
        for(i=0; i<4;     i=i+1) fc_scores[i]  = 0;
        
        $readmemh("weights.hex",    weights);
        $readmemh("biases.hex",     biases);   
        $readmemh("fc_weights.hex", fc_weights);
        $readmemh("fc_biases.hex",  fc_biases);
    end

    localparam IDLE       = 3'd0;
    localparam ADDR_SETUP = 3'd7;
    localparam CALC_CONV  = 3'd1;
    localparam WRITE_CONV = 3'd2;
    localparam CALC_FC    = 3'd3;
    localparam STORE_FC   = 3'd4;
    localparam ARGMAX     = 3'd5;
    localparam DONE       = 3'd6;

    reg [2:0] state;

    reg [4:0] out_y;
    reg [4:0] out_x;
    reg [3:0] filter_ch;
    reg [3:0] k_y;
    reg [3:0] k_x;
    
    reg [11:0] fc_in_idx;
    reg [2:0]  fc_out_idx;

    reg signed [31:0] acc;

    // *** BUG 2 DÜZELTMESİ: Kombinasyonel wire - always bloğu dışında, her cycle anlık hesap ***
    // Non-blocking tuzağından kaçınmak için register değil wire kullan
    wire signed [10:0] cur_row = ($signed({1'b0, out_y}) * STRIDE) + $signed({1'b0, k_y}) - PAD_TOP;
    wire signed [10:0] cur_col = ($signed({1'b0, out_x}) * STRIDE) + $signed({1'b0, k_x}) - PAD_LEFT;
    wire addr_valid = (cur_row >= 0) && (cur_row < INPUT_H) &&
                      (cur_col >= 0) && (cur_col < INPUT_W);
    wire [10:0] flat_addr = cur_row[5:0] * INPUT_W + cur_col[5:0];

    // ADDR_SETUP'ta kaydedilen geçerlilik durumu (CALC_CONV için)
    reg addr_was_valid;

    reg signed [31:0] max_val;
    reg [7:0] best_class;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state          <= IDLE;
            done           <= 0;
            busy           <= 0;
            out_ram_wen    <= 0;
            out_y          <= 0; out_x <= 0; filter_ch <= 0; k_y <= 0; k_x <= 0;
            fc_in_idx      <= 0; fc_out_idx <= 0;
            acc            <= 0;
            addr_was_valid <= 0;
            ram_addr       <= 0;
        end else begin
            case (state)

                // --- IDLE ---
                IDLE: begin
                    done        <= 0;
                    out_ram_wen <= 0;
                    if (start) begin
                        state      <= ADDR_SETUP;
                        busy       <= 1;
                        out_y      <= 0; out_x <= 0; filter_ch <= 0; k_y <= 0; k_x <= 0;
                        acc        <= biases[0];
                    end
                end

                // --- ADDR_SETUP ---
                // cur_row/cur_col wire olduğu için BU CYCLE'DA zaten doğru değerde.
                // ram_addr'ı şimdi ver → bir sonraki cycle (CALC_CONV) geldiğinde ram_rdata hazır.
                ADDR_SETUP: begin
                    if (addr_valid) begin
                        ram_addr       <= flat_addr;
                        addr_was_valid <= 1;
                    end else begin
                        addr_was_valid <= 0;  // padding bölgesi
                    end
                    state <= CALC_CONV;
                end

                // --- CALC_CONV ---
                // ram_rdata bu cycle'da geçerli (adres bir önceki cycle'da verildi).
                CALC_CONV: begin
                    if (addr_was_valid) begin
                        // *** BUG 1 DÜZELTMESİ: zero_point = -128, formül: (pixel + 128) * weight ***
                        // int8 input'un unsigned değeri = pixel - zero_point = pixel - (-128) = pixel + 128
                        acc <= acc + ($signed(ram_rdata) + 32'sd128) *
                                     $signed(weights[k_y * 64 + k_x * 8 + filter_ch]);
                    end
                    // Padding ise: 0 * weight = 0, acc değişmez - doğru davranış.

                    // Sayaçları ilerlet
                    if (k_x < FILTER_W - 1) begin
                        k_x   <= k_x + 1;
                        state <= ADDR_SETUP;
                    end else begin
                        k_x <= 0;
                        if (k_y < FILTER_H - 1) begin
                            k_y   <= k_y + 1;
                            state <= ADDR_SETUP;
                        end else begin
                            // Filtre penceresi bitti → sonucu yaz
                            state <= WRITE_CONV;
                        end
                    end
                end

                // --- WRITE_CONV ---
                WRITE_CONV: begin
                    if (acc < 0) 
                        conv_out_buf[(out_y * 20 * 8) + (out_x * 8) + filter_ch] <= 8'sd0;
                    else if (acc > 127) 
                        conv_out_buf[(out_y * 20 * 8) + (out_x * 8) + filter_ch] <= 8'sd127;
                    else 
                        conv_out_buf[(out_y * 20 * 8) + (out_x * 8) + filter_ch] <= acc[7:0];
                        
                    k_y <= 0; k_x <= 0; 
                    
                    if (filter_ch < 7) begin
                        filter_ch <= filter_ch + 1;
                        acc       <= biases[filter_ch + 1];
                        state     <= ADDR_SETUP;
                    end else begin
                        filter_ch <= 0;
                        acc       <= biases[0]; 
                        
                        if (out_x < 19) begin 
                            out_x <= out_x + 1;
                            state <= ADDR_SETUP;
                        end else begin
                            out_x <= 0;
                            if (out_y < 24) begin 
                                out_y <= out_y + 1;
                                state <= ADDR_SETUP;
                            end else begin
                                state      <= CALC_FC;
                                fc_in_idx  <= 0;
                                fc_out_idx <= 0;
                                acc        <= fc_biases[0];
                            end
                        end
                    end
                end

                // --- CALC_FC ---
                CALC_FC: begin
                    acc <= acc + $signed(conv_out_buf[fc_in_idx]) *
                                 $signed(fc_weights[fc_out_idx * 4000 + fc_in_idx]);
                    
                    if (fc_in_idx < 3999) begin
                        fc_in_idx <= fc_in_idx + 1;
                    end else begin
                        state <= STORE_FC;
                    end
                end
                
                // --- STORE_FC ---
                STORE_FC: begin
                    fc_scores[fc_out_idx] <= acc;
                    
                    if (fc_out_idx < 3) begin
                        fc_out_idx <= fc_out_idx + 1;
                        fc_in_idx  <= 0;
                        acc        <= fc_biases[fc_out_idx + 1];
                        state      <= CALC_FC;
                    end else begin
                        state <= ARGMAX;
                    end
                end
                
                // --- ARGMAX ---
                ARGMAX: begin
                    max_val    = fc_scores[0];
                    best_class = 8'd0;
                    
                    if (fc_scores[1] > max_val) begin max_val = fc_scores[1]; best_class = 8'd1; end
                    if (fc_scores[2] > max_val) begin max_val = fc_scores[2]; best_class = 8'd2; end
                    if (fc_scores[3] > max_val) begin max_val = fc_scores[3]; best_class = 8'd3; end
                    
                    out_ram_addr  <= 13'd0;
                    out_ram_wdata <= best_class;
                    out_ram_wen   <= 1'b1;
                    
                    $display("FC Skor[0]=Sessizlik:  %d", fc_scores[0]);
                    $display("FC Skor[1]=Bilinmeyen: %d", fc_scores[1]);
                    $display("FC Skor[2]=Evet:       %d", fc_scores[2]);
                    $display("FC Skor[3]=Hayir:      %d", fc_scores[3]);
                    $display("Kazanan sinif: %d", best_class);
                    
                    state <= DONE;
                end

                // --- DONE ---
                DONE: begin
                    done        <= 1;
                    busy        <= 0;
                    out_ram_wen <= 0;
                    state       <= IDLE; 
                end
                
                default: state <= IDLE;
            endcase
        end
    end
endmodule
